# ---------------------------------------------------------------------------
# brancol — environment variables
#
# Copy to `.env.local` and fill in real values. Placeholders only in this file.
# Every variable here is SERVER-ONLY. Never prefix any of them with
# NEXT_PUBLIC_ — that would ship the value to the browser.
# ---------------------------------------------------------------------------

# --- OpenRouter (required) -------------------------------------------------

# API key for OpenRouter. Server-only. https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model used for the first palette-generation attempt.
# Optional — defaults to google/gemma-4-26b-a4b-it:free
OPENROUTER_PRIMARY_MODEL=google/gemma-4-26b-a4b-it:free

# Comma-separated model slugs tried in order if the primary model fails.
# Optional — defaults to z-ai/glm-5.2:free
OPENROUTER_FALLBACK_MODELS=z-ai/glm-5.2:free

# --- Upstash Redis, used for rate limiting (optional) ----------------------
# Leave both unset to disable rate limiting in local development.
# If you set one you must set the other.

UPSTASH_REDIS_REST_URL=https://your-database-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
